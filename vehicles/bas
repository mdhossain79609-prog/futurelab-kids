<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no"><meta name="theme-color" content="#6339b6"><title>FutureLab Kids - 3D Car Workshop</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#e7f4ff;color:#24364b;font-family:Arial,sans-serif}.app{max-width:900px;margin:auto;padding:8px}header{background:linear-gradient(120deg,#6339b6,#9b5de5);color:white;text-align:center;padding:12px;border-radius:15px}h1{font-size:23px;margin:0}header p{font-size:11px;margin:4px}h2{text-align:center;color:#6339b6;font-size:17px;margin:10px}.toolbar,.row{display:flex;justify-content:center;gap:7px;flex-wrap:wrap;margin:8px 0}button{font:inherit;cursor:pointer}.tool,.small{border:0;border-radius:9px;padding:9px 13px;background:#fff;font-weight:bold}.stage{position:relative;border:4px solid #76502d;border-radius:16px;overflow:hidden;background:#8ba6c1}#view{display:block;width:100%;height:290px;touch-action:none}.tag{position:absolute;top:8px;left:8px;background:#ffffffd9;border-radius:8px;padding:6px;font-size:11px;font-weight:bold}.hint{position:absolute;bottom:5px;text-align:center;width:100%;font-size:10px;background:#ffffff99;padding:4px}.status{text-align:center;min-height:27px;padding:7px;font-size:12px;font-weight:bold;color:#6339b6}.panel{background:white;border:2px solid #d1e1f1;border-radius:13px;padding:9px;margin-top:8px}.ptitle{text-align:center;color:#6339b6;font-weight:bold;margin-bottom:8px}.parts{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}.part{min-height:62px;border:2px solid #d5e3f1;border-radius:11px;background:linear-gradient(#fff,#dcecff);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;touch-action:manipulation}.part span{font-size:23px}.part small{font-size:10px;font-weight:bold}.part.used{opacity:.35;background:#eaffef}.actions,.studios{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:8px}.action,.studio{border:0;border-radius:11px;min-height:48px;color:white;font-weight:bold;padding:6px 2px}.reset{background:#64748b}.solar{background:#ea8b08}.test{background:#16a34a}.color{background:#db2777}.light{background:#eab308}.music{background:#6339b6}.sub{display:none;background:white;border:2px solid #d8c9f4;border-radius:12px;padding:10px;margin-top:8px}.sub h3{text-align:center;color:#6339b6;margin:0 0 9px;font-size:15px}.swatches{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.swatch{height:36px;border:3px solid white;border-radius:8px}.small{background:#6339b6;color:white}.drive{display:none;margin-top:10px;background:#d9efff;border:3px solid #a9c9e5;border-radius:15px;padding:9px}.drivegrid{display:grid;grid-template-columns:1fr 125px;gap:8px}.road{height:240px;position:relative;overflow:hidden;border:5px solid #334155;border-radius:12px;background:repeating-linear-gradient(90deg,#4b5563 0 44%,#facc15 44% 45%,#4b5563 45% 55%,#facc15 55% 56%,#4b5563 56%)}.road:after{content:"";position:absolute;left:50%;top:0;bottom:0;border-left:6px dashed white;animation:road .4s linear infinite;display:none}.road.moving:after{display:block}@keyframes road{to{transform:translateY(50px)}}.drivecar{position:absolute;z-index:2;width:90px;height:130px;left:50%;bottom:15px;transform:translateX(-50%);transition:left .1s}.drivebody{position:absolute;inset:5px 8px;background:linear-gradient(90deg,#173c88,#60a5fa,#173c88);border:4px solid #17366e;border-radius:25px}.window{position:absolute;top:32px;left:24px;width:42px;height:45px;background:#a5e8fa;border:3px solid #17366e;border-radius:12px}.wheel{position:absolute;left:0;top:30px;width:17px;height:32px;border-radius:6px;background:#111827;border:3px solid #aaa;z-index:3}.wr{left:auto;right:0}.w2{top:auto;bottom:20px}.controls{background:#f5f3ff;border:2px solid #b9a5e8;border-radius:12px;padding:7px;display:flex;flex-direction:column;gap:7px}.controls b{text-align:center;color:#6339b6;font-size:11px}.steer{width:75px;height:75px;align-self:center;border:11px solid #263445;border-radius:50%;background:#94a3b8;touch-action:none}.pedals{display:grid;grid-template-columns:1fr 1fr;gap:5px}.pedals button,.drivebtn,.back{border:0;border-radius:8px;padding:9px 2px;color:white;font-size:10px;font-weight:bold;background:#16a34a}.pedals button:nth-child(2){background:#dc2626}.pedals button:nth-child(3){background:#f59e0b}.back{background:#6339b6}footer{text-align:center;color:#789;font-size:10px;padding:12px}@media(max-width:390px){#view{height:250px}.part{min-height:56px}.drivegrid{grid-template-columns:1fr 112px}}
</style></head><body><div class="app">
<header><h1>🚀 FutureLab Kids</h1><p>JUNIOR 3D CAR WORKSHOP</p></header><h2>🔧 BUILD YOUR DREAM CAR</h2>
<div class="toolbar"><button class="tool" id="zin">＋ Zoom</button><button class="tool" id="zout">－ Zoom</button><button class="tool" id="resetView">↺ Reset View</button></div>
<section class="stage"><div class="tag">BUILDING AREA</div><canvas id="view"></canvas><div class="hint">Drag parts onto the car • Drag car to rotate • Zoom with buttons or pinch</div></section>
<div class="status" id="status">Drag parts to the car to build it!</div>
<section class="panel"><div class="ptitle">🧰 WORKSHOP PARTS</div><div class="parts" id="parts">
<button class="part" data-p="chassis"><span>🛠️</span><small>Chassis</small></button><button class="part" data-p="engine"><span>⚙️</span><small>Engine</small></button><button class="part" data-p="axle"><span>🔩</span><small>Axle</small></button><button class="part" data-p="wheels"><span>🛞</span><small>Wheels</small></button><button class="part" data-p="steering"><span>🕹️</span><small>Steering</small></button><button class="part" data-p="brakes"><span>🛑</span><small>Brakes</small></button><button class="part" data-p="body"><span>🚘</span><small>Body</small></button><button class="part" data-p="battery"><span>🔋</span><small>Battery</small></button><button class="part" data-p="seat"><span>💺</span><small>Seat</small></button><button class="part" data-p="lights"><span>💡</span><small>Lights</small></button><button class="part" data-p="mirror"><span>🪞</span><small>Mirror</small></button><button class="part" data-p="solar"><span>☀️</span><small>Solar Panel</small></button></div>
<div class="actions"><button class="action reset" id="reset">↻ RESET</button><button class="action solar" id="solarBtn">☀️ SOLAR SYSTEM</button><button class="action test" id="test" disabled>🏁 TEST DRIVE</button></div>
<div class="studios"><button class="studio color" id="colorBtn">🎨 COLOR STUDIO</button><button class="studio light" id="lightBtn">💡 LIGHTING STUDIO</button><button class="studio music" id="musicBtn">🎵 MUSIC STUDIO</button></div>
<div class="sub" id="colors"><h3>🎨 Choose Your Car Color</h3><div class="swatches"><button class="swatch" data-c="#1976d2" style="background:#1976d2"></button><button class="swatch" data-c="#e53935" style="background:#e53935"></button><button class="swatch" data-c="#16a34a" style="background:#16a34a"></button><button class="swatch" data-c="#facc15" style="background:#facc15"></button><button class="swatch" data-c="#9333ea" style="background:#9333ea"></button><button class="swatch" data-c="#111827" style="background:#111827"></button><button class="swatch" data-c="#f8fafc" style="background:#f8fafc"></button><button class="swatch" data-c="#f97316" style="background:#f97316"></button></div></div>
<div class="sub" id="lighting"><h3>💡 LIGHTING STUDIO</h3><div class="row"><button class="small" id="head">Headlights OFF</button><button class="small" id="tail">Tail lights OFF</button><button class="small" id="cabin">Cabin OFF</button></div></div>
<div class="sub" id="music"><h3>🎵 MUSIC STUDIO</h3><div class="row"><button class="small" id="play">▶ PLAY</button><button class="small" id="stop">■ STOP</button><label>Volume <input id="volume" type="range" min="0" max="100" value="35"></label></div><p style="text-align:center;font-size:10px">Original electronic melody</p></div>
<div class="sub" id="solar"><h3>☀️ SOLAR POWER SYSTEM</h3><p style="text-align:center;font-size:12px">Install Solar Panel, then turn on solar charging.</p><div class="row"><button class="small" id="solarPower">Solar Power OFF</button><b id="battery">Battery 0%</b></div></div></section>
<section class="drive" id="drive"><h2>🏁 TEST DRIVE</h2><div class="drivegrid"><div class="road" id="road"><div class="drivecar" id="driveCar"><div class="drivebody" id="driveBody"></div><div class="window"></div><i class="wheel"></i><i class="wheel wr"></i><i class="wheel w2"></i><i class="wheel wr w2"></i></div></div><div class="controls"><b>STEERING</b><div class="steer" id="steer"></div><button class="drivebtn" id="driveToggle">▶ START</button><div class="pedals"><button id="clutch">CLUTCH</button><button id="brake">BRAKE</button><button id="accelerator">ACCELERATOR</button><button id="gear">GEAR: N</button></div><button class="back" id="back">← WORKSHOP</button></div></div></section>
<footer>FutureLab Kids • Build, learn and explore • No external 3D library required</footer></div>
<script>
(()=>{const $=id=>document.getElementById(id),cv=$("view"),c=cv.getContext("2d"),parts=["chassis","engine","axle","wheels","steering","brakes","body","battery","seat","lights","mirror","solar"],names={chassis:"Chassis",engine:"Engine",axle:"Axle",wheels:"Wheels",steering:"Steering",brakes:"Brakes",body:"Body",battery:"Battery",seat:"Seat",lights:"Lights",mirror:"Mirror",solar:"Solar Panel"},icons={chassis:"🛠️",engine:"⚙️",axle:"🔩",wheels:"🛞",steering:"🕹️",brakes:"🛑",body:"🚘",battery:"🔋",seat:"💺",lights:"💡",mirror:"🪞",solar:"☀️"};
let done={},paint="#1976d2",zoom=1,turn=0,light={head:false,tail:false,cabin:false},solarOn=false,charge=0,drag=null,rotating=false,lastX=0,running=false,gas=false,gear=0,lane=0,speed=0,audio=null,gain=null,timer=null,note=0;
function say(t){$("status").textContent=t}function ready(){return ["chassis","engine","axle","wheels","steering","brakes","body"].every(x=>done[x])}
function update(){document.querySelectorAll(".part").forEach(b=>b.classList.toggle("used",!!done[b.dataset.p]));$("test").disabled=!ready();draw()}
function rr(x,y,w,h,r,fill,stroke){c.beginPath();c.roundRect(x,y,w,h,r);c.fillStyle=fill;c.fill();if(stroke){c.strokeStyle=stroke;c.lineWidth=2;c.stroke()}}
function wheel(x,y){c.fillStyle="#111827";c.beginPath();c.ellipse(x,y,12,19,0,0,7);c.fill();c.fillStyle="#cbd5e1";c.beginPath();c.ellipse(x,y,5,11,0,0,7);c.fill()}
function draw(){let w=cv.clientWidth,h=cv.clientHeight,d=Math.min(devicePixelRatio||1,2);cv.width=w*d;cv.height=h*d;c.setTransform(d,0,0,d,0,0);c.clearRect(0,0,w,h);let bg=c.createLinearGradient(0,0,w,h);bg.addColorStop(0,"#dceeff");bg.addColorStop(1,"#7896b5");c.fillStyle=bg;c.fillRect(0,0,w,h);c.save();c.translate(w/2,h*.59);c.scale(zoom,zoom);c.rotate(turn*.13);c.fillStyle="#20344b55";c.beginPath();c.ellipse(0,52,145,17,0,0,7);c.fill();
if(done.chassis)rr(-125,13,250,25,7,"#667d92","#26384d");
if(done.axle){c.strokeStyle="#334155";c.lineWidth=7;[-85,85].forEach(x=>{c.beginPath();c.moveTo(x,-3);c.lineTo(x,45);c.stroke()})}
if(done.wheels){[-90,90].forEach(x=>{wheel(x,37);wheel(x,-4)})}
if(done.body){let g=c.createLinearGradient(0,-80,0,40);g.addColorStop(0,"#ffffff");g.addColorStop(.25,paint);g.addColorStop(1,"#26384d");c.beginPath();c.moveTo(-130,25);c.lineTo(-116,-12);c.quadraticCurveTo(-100,-30,-60,-32);c.lineTo(-30,-68);c.quadraticCurveTo(-18,-80,10,-78);c.lineTo(62,-70);c.quadraticCurveTo(82,-60,98,-29);c.lineTo(130,-15);c.lineTo(137,20);c.quadraticCurveTo(130,40,108,40);c.lineTo(-110,40);c.quadraticCurveTo(-135,40,-130,25);c.fillStyle=g;c.fill();c.strokeStyle="#26384d";c.lineWidth=4;c.stroke();rr(-48,-63,68,32,8,"#a5e5fa","#29435c");rr(25,-62,43,31,7,"#9be1f5","#29435c")}
if(done.engine)rr(-85,-3,45,26,5,"#9ca3af","#334155");if(done.battery)rr(68,1,25,22,4,"#334155","#facc15");if(done.seat){rr(-5,-26,25,30,6,"#7c3aed");rr(27,-26,25,30,6,"#7c3aed")}if(done.steering){c.strokeStyle="#172033";c.lineWidth=5;c.beginPath();c.arc(55,-28,12,0,7);c.stroke()}if(done.brakes){c.fillStyle="#ef4444";[-90,90].forEach(x=>{c.beginPath();c.arc(x,37,7,0,7);c.fill()})}
if(done.mirror){rr(77,-47,17,8,3,"#334155");rr(-94,-47,17,8,3,"#334155")}if(done.solar){rr(-20,-84,70,12,3,"#164e8a","#bfdbfe");c.strokeStyle="#bfdbfe";for(let x=-8;x<48;x+=14){c.beginPath();c.moveTo(x,-83);c.lineTo(x,-73);c.stroke()}}
if(done.lights){rr(119,0,14,11,3,light.head?"#fff7a8":"#fde68a");rr(-136,2,11,12,3,light.tail?"#ff1838":"#991b1b");if(light.head){c.shadowColor="#fff5a0";c.shadowBlur=25;c.fillStyle="#fff5a0";c.fillRect(125,-8,38,25);c.shadowBlur=0}if(light.cabin){c.shadowColor="#fff7a8";c.shadowBlur=20;c.fillStyle="#fff7a8";c.fillRect(0,-56,7,5);c.shadowBlur=0}}
c.restore()}
function install(p){if(done[p])return;if(p!=="chassis"&&!done.chassis){say("Install the chassis first.");return}if(p==="wheels"&&!done.axle){say("Install the axle first.");return}if(p==="body"&&!["engine","axle","wheels","steering","brakes"].every(x=>done[x])){say("Install engine, axle, wheels, steering and brakes first.");return}done[p]=true;update();say(names[p]+" installed!")}
document.querySelectorAll(".part").forEach(b=>b.addEventListener("click",()=>{let p=b.dataset.p;if(!done[p])install(p);else say(names[p]+" is already installed.")}));
cv.addEventListener("pointerdown",e=>{rotating=true;lastX=e.clientX;cv.setPointerCapture(e.pointerId)});cv.addEventListener("pointermove",e=>{if(rotating){turn+=(e.clientX-lastX)*.01;lastX=e.clientX;draw()}});["pointerup","pointercancel"].forEach(ev=>cv.addEventListener(ev,()=>rotating=false));
$("zin").onclick=()=>{zoom=Math.min(1.8,zoom+.12);draw()};$("zout").onclick=()=>{zoom=Math.max(.65,zoom-.12);draw()};$("resetView").onclick=()=>{zoom=1;turn=0;draw()};
function panel(id){$(id).style.display=$(id).style.display==="block"?"none":"block"}$("colorBtn").onclick=()=>panel("colors");$("lightBtn").onclick=()=>panel("lighting");$("musicBtn").onclick=()=>panel("music");$("solarBtn").onclick=()=>panel("solar");
document.querySelectorAll(".swatch").forEach(b=>b.onclick=()=>{paint=b.dataset.c;draw();say("Car color changed!")});
function lightToggle(k,id,label){light[k]=!light[k];$(id).textContent=label+" "+(light[k]?"ON":"OFF");draw()}$("head").onclick=()=>lightToggle("head","head","Headlights");$("tail").onclick=()=>lightToggle("tail","tail","Tail lights");$("cabin").onclick=()=>lightToggle("cabin","cabin","Cabin");
$("solarPower").onclick=()=>{if(!done.solar){say("Install the Solar Panel part first.");return}solarOn=!solarOn;$("solarPower").textContent="Solar Power "+(solarOn?"ON":"OFF");if(solarOn)chargeUp();say(solarOn?"Solar charging started!":"Solar charging stopped.")};function chargeUp(){if(!solarOn)return;charge=Math.min(100,charge+1);$("battery").textContent="Battery "+charge+"%";setTimeout(chargeUp,700)}
let AC=window.AudioContext||window.webkitAudioContext;const melody=[523,659,784,659,587,698,880,698,523,587,659,784];async function play(){if(!AC){say("Audio is not supported.");return}if(!audio){audio=new AC();gain=audio.createGain();gain.connect(audio.destination)}await audio.resume();stop();gain.gain.value=+$("volume").value/100;function tick(){let o=audio.createOscillator(),g=audio.createGain();o.type="sine";o.frequency.value=melody[note++%melody.length];g.gain.setValueAtTime(.0001,audio.currentTime);g.gain.exponentialRampToValueAtTime(.12,audio.currentTime+.04);g.gain.exponentialRampToValueAtTime(.0001,audio.currentTime+.35);o.connect(g);g.connect(gain);o.start();o.stop(audio.currentTime+.4)}tick();timer=setInterval(tick,460);say("Music playing.")}function stop(){if(timer){clearInterval(timer);timer=null}if(audio&&audio.state==="running")audio.suspend()}$("play").onclick=play;$("stop").onclick=()=>{stop();say("Music stopped.")};$("volume").oninput=()=>{if(gain)gain.gain.value=+$("volume").value/100};
$("reset").onclick=()=>{done={};light={head:false,tail:false,cabin:false};solarOn=false;charge=0;$("solarPower").textContent="Solar Power OFF";$("battery").textContent="Battery 0%";$("head").textContent="Headlights OFF";$("tail").textContent="Tail lights OFF";$("cabin").textContent="Cabin OFF";update();say("Workshop reset. Install chassis first.")};
$("test").onclick=()=>{if(!ready())return;$("drive").style.display="block";$("drive").scrollIntoView({behavior:"smooth"})};$("back").onclick=()=>{stopDrive();$("drive").style.display="none";scrollTo({top:0,behavior:"smooth"})};
const gears=["N","1","2","3","R"];$("gear").onclick=()=>{gear=(gear+1)%5;$("gear").textContent="GEAR: "+gears[gear]};function stopDrive(){running=false;gas=false;speed=0;$("road").classList.remove("moving");$("driveToggle").textContent="▶ START"}$("driveToggle").onclick=()=>{if(running){stopDrive();return}if(!gear){say("Choose a gear first.");return}running=true;$("road").classList.add("moving");$("driveToggle").textContent="■ STOP";loop()};$("accelerator").onpointerdown=()=>{if(running&&gear)gas=true};["pointerup","pointercancel","pointerleave"].forEach(ev=>$("accelerator").addEventListener(ev,()=>gas=false));$("brake").onclick=()=>{gas=false;speed=0};$("clutch").onclick=()=>gas=false;let steerX=null;$("steer").onpointerdown=e=>{steerX=e.clientX;$("steer").setPointerCapture(e.pointerId)};$("steer").onpointermove=e=>{if(steerX===null)return;lane=Math.max(-48,Math.min(48,lane+(e.clientX-steerX)));steerX=e.clientX;$("driveCar").style.left="calc(50% + "+lane+"px)"};["pointerup","pointercancel"].forEach(ev=>$("steer").addEventListener(ev,()=>steerX=null));function loop(){if(!running)return;if(gas)speed=Math.min(14,speed+.3);else speed=Math.max(0,speed-.15);$("road").style.backgroundPositionY=(parseFloat($("road").style.backgroundPositionY)||0)+speed+"px";requestAnimationFrame(loop)}
window.addEventListener("resize",draw);update();draw();
})();
</script></body></html>
